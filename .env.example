# 실행 환경 (local 또는 prod)
SPRING_PROFILES_ACTIVE=

# PostgreSQL 접속 URL
SPRING_DATASOURCE_URL=

# PostgreSQL 로그인 계정
SPRING_DATASOURCE_USERNAME=

# PostgreSQL 로그인 비밀번호
SPRING_DATASOURCE_PASSWORD=

# 구글 OAuth 클라이언트 ID
GOOGLE_CLIENT_ID=

# 구글 OAuth 클라이언트 비밀값
GOOGLE_CLIENT_SECRET=

# 구글 로그인 콜백 URL
GOOGLE_REDIRECT_URI=

# 로그인 성공 시 이동할 프런트 URL
APP_LOGIN_SUCCESS_URL=

# 로그인 실패 시 이동할 프런트 URL
APP_LOGIN_FAILURE_URL=

# API 호출을 허용할 프런트 출처
APP_CORS_ALLOWED_ORIGINS=

# 비활성 세션 만료 시간
SERVER_SERVLET_SESSION_TIMEOUT=

# 세션 쿠키의 HTTPS 전용 여부
SERVER_SERVLET_SESSION_COOKIE_SECURE=

# 세션 쿠키의 SameSite 정책
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=

# FastAPI 접속 주소 (기본값: http://127.0.0.1:18001)
APP_EMBEDDING_BASE_URL=

# FastAPI 내부 인증키 (사용하는 경우 X-API-Key 값)
APP_EMBEDDING_API_KEY=

# FastAPI 연결 제한 시간 (기본값: 2s)
APP_EMBEDDING_CONNECT_TIMEOUT=

# FastAPI 응답 제한 시간 (기본값: 30s)
APP_EMBEDDING_READ_TIMEOUT=
